# Discord Developer Portal > Bot
DISCORD_TOKEN=put_your_bot_token_here
DISCORD_CLIENT_ID=your_application_id
# Optional: commands only register in this guild while testing (instant updates)
DISCORD_GUILD_ID=your_test_server_id

# Minecraft Java server address (status / players)
MC_HOST=127.0.0.1
MC_PORT=25565
MC_QUERY_TIMEOUT_MS=5000

# RCON must be enabled in server.properties. Never expose RCON port publicly.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change_this_password

# Optional admin role ID. If blank, Discord Administrator permission is required.
ADMIN_ROLE_ID=
# Optional channel ID for server status updates / audit messages
STATUS_CHANNEL_ID=
AUDIT_CHANNEL_ID=

# Optional absolute paths to trusted executable scripts you create for your host/panel.
# Scripts should safely start/stop/restart your server. Leave blank to disable those actions.
START_SCRIPT=
STOP_SCRIPT=
RESTART_SCRIPT=

# Optional backup destination and world directory. Backups can be large.
MC_WORLD_DIR=/path/to/minecraft/world
BACKUP_DIR=./backups
MAX_BACKUPS=10

# Advanced / multi-server configuration
# Optional JSON array overrides the single-server variables above. Example:
# MC_SERVERS_JSON=[{"id":"survival","name":"Survival","host":"127.0.0.1","port":25565,"rconHost":"127.0.0.1","rconPort":25575,"rconPassword":"replace-me","worldDir":"/srv/minecraft/world","pluginDir":"/srv/minecraft/plugins","logFile":"/srv/minecraft/logs/latest.log","scripts":{"start":"/usr/local/bin/mc-start","stop":"/usr/local/bin/mc-stop","restart":"/usr/local/bin/mc-restart"}}]
MC_PLUGIN_DIR=/path/to/minecraft/plugins
# Absolute path to latest.log; each server can also set logFile in MC_SERVERS_JSON
MC_LOG_FILE=/path/to/minecraft/logs/latest.log
# Scheduled cron expressions use the host's local timezone. Leave blank to disable.
AUTO_BACKUP_CRON=0 3 * * *
AUTO_RESTART_CRON=0 5 * * 0
# Persistent append-only audit history (protect this file and its parent directory)
CHEST_AUDIT_FILE=./data/audit.jsonl
# Dashboard must use a long random secret (32+ chars), and should remain localhost-only by default
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=replace_with_at_least_32_random_characters
# Require RCON save-all flush to succeed before a backup; set true for strict consistency
BACKUP_REQUIRE_RCON=false
# Comma-separated hostnames if implementing trusted plugin downloads in your deployment
APPROVED_PLUGIN_HOSTS=
# Optional allowlist for /plugin install (comma-separated hostnames, no scheme)
APPROVED_PLUGIN_HOSTS=hangar.papermc.io
